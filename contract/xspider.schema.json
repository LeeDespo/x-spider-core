          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      }
    },
    "crawl.run": {
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "user_id"
        ],
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "medias",
              "tweets"
            ]
          },
          "user_id": {
            "type": "string"
          },
          "cursor": {
            "type": "string",
            "description": "从哪儿续爬（上一轮返回的 next_cursor）。"
          },
          "strategy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "since": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "until": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "media_types": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "photo",
                    "video",
                    "animated_gif"
                  ]
                }
              },
              "wanted_keys": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "收齐即停。**它进契约**：改变翻页终止条件（省请求）。"
              },
              "limits": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "page_size": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "page_throttle_ms": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "max_pages": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "empty_page_limit": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "**辅助**上限，默认 5。不要拿它当主终止判据。"
                  },
                  "stop_when_older_than": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "done_reason",
          "candidates"
        ],
        "properties": {
          "done_reason": {
            "$ref": "#/$defs/doneReason"
          },
          "candidates": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/candidate"
            }
          },
          "posts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/post"
            },
            "description": "这一轮**保留了**的推文（即产出了候选的那些），按服务端顺序、按 id 去重——与 `candidates` 是同一批数据的两个视角。候选是**有损**的（只有 url/标量），而按用户的文件名模板命名、把任务写进外壳自己的历史记录都需要正文、作者昵称/id、标签、媒体宽高与页内序号，所以完整推文也一并给出。"
          },
          "pages": {
            "type": "integer"
          },
          "raw_items": {
            "type": "integer",
            "description": "服务端原始条目数——**到底判据只看它**，不看筛选后的（docs/02 §D5）。"
          },
          "dropped": {
            "type": "object"
          },
          "next_cursor": {
            "type": "string"
          },
          "seq": {
            "type": "integer",
            "description": "本次调用结束时的进程内事件序号；单调递增、不回退。"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "只包含本次调用期间产生的爬取事件，不含历史轮次。"
          }
        }
      }
    }
  }
}
