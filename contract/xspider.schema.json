{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/x-spider-core/xspider.schema.json",
  "title": "X-Spider 契约 1.3.0",
  "description": "X-Spider 组件对外契约的机器可读版本。外壳不必读实现即可对接：先读 xspider_version() 握手，再把 method + params 交给 xspider_call / sidecar。契约里绝不出现端点路径、queryId、features 常量或 HTTP 头——那些是实现细节，写进来就把契约焊死在今天的 X 上。",
  "oneOf": [
    {
      "$ref": "#/$defs/resultEnvelope"
    },
    {
      "$ref": "#/$defs/errorEnvelope"
    }
  ],
  "$defs": {
    "resultEnvelope": {
      "title": "成功包络",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result"
      ],
      "properties": {
        "result": {}
      }
    },
    "errorEnvelope": {
      "title": "失败包络",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "$ref": "#/$defs/error"
        }
      }
    },
    "error": {
      "title": "结构化错误",
      "description": "只按 code 做判断，不许匹配 message 文案。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_request",
            "unauthorized",
            "rate_limited",
            "not_found",
            "upstream",
            "parse",
            "transport",
            "cancelled",
            "internal"
          ]
        },
        "message": {
          "type": "string",
          "description": "给人看的说明；不可用于逻辑判断。"
        },
        "retry_after_s": {
          "type": "integer",
          "minimum": 0,
          "description": "仅 rate_limited：建议等待秒数。"
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599,
          "description": "仅 upstream：上游 HTTP 状态码。"
        },
        "context": {
          "type": "string",
          "description": "仅 parse：解析失败的位置，例如 entries[0].content.itemContent。"
        },
        "endpoint": {
          "type": "string",
          "description": "逻辑端点名（如 user_by_screen_name），不是 URL 路径。"
        },
        "detail": {
          "type": "object",
          "description": "仅 transport：{\"kind\": ...}。",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "timeout",
                "connect",
                "body",
                "fixture",
                "other"
              ]
            }
          }
        }
      }
    },
    "integrity": {
      "title": "完整性结论",
      "description": "**没有 expected 就绝不能声称「校验通过」**（docs/02 §E2）——所以是两种形状，不是「expected 可空」。",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "expected",
            "actual"
          ],
          "properties": {
            "result": {
              "const": "verified"
            },
            "expected": {
              "type": "integer",
              "minimum": 0
            },
            "actual": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "actual"
          ],
          "properties": {
            "result": {
              "const": "unverified"
            },
            "actual": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "downloadEvent": {
      "title": "下载事件",
      "description": "四种事件用 `kind` 判别。外壳按 `kind` + 结构化字段判断，**绝不看 message 文案**（docs/CONTRACT.md §5）。",
      "oneOf": [
        {
          "title": "进度",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "job_id",
            "done",
            "total"
          ],
          "properties": {
            "kind": {
              "const": "progress"
            },
            "job_id": {
              "type": "string"
            },
            "done": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "title": "完成",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "job_id",
            "path",
            "bytes",
            "integrity"
          ],
          "properties": {
            "kind": {
              "const": "completed"
            },
            "job_id": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "integrity": {
              "$ref": "#/$defs/integrity"
            }
          }
        },
        {
          "title": "失败",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "job_id",
            "reason",
            "error"
          ],
          "properties": {
            "kind": {
              "const": "failed"
            },
            "job_id": {
              "type": "string"
            },
            "reason": {
              "type": "string",
              "description": "结构化短标签（cancelled / not_found / integrity_failed / truncated / transport / disk_full / upstream / invalid…）。**按它判断，不要按文案**。"
            },
            "error": {
              "$ref": "#/$defs/error"
            }
          }
        },
        {
          "title": "跳过",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "job_id",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "skipped"
            },
            "job_id": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          }
        }
      ]
    },
    "method": {
      "title": "method 名",
      "description": "与 crates/xspider-ffi/src/engine.rs 的 METHODS 集合相等（由 contract_guard 测试强制）。只增不改不删。",
      "type": "string",
      "enum": [
        "system.version",
        "system.methods",
        "auth.set_cookie",
        "auth.whoami",
        "net.set_limits",
        "net.set_proxy",
        "net.status",
        "net.probe_size",
        "fetch.get_user",
        "fetch.user_medias",
        "fetch.user_tweets",
        "fetch.tweet_detail",
        "fetch.search_timeline",
        "fetch.home_timeline",
        "fetch.following",
        "fetch.is_following",
        "fetch.mutate",
        "dl.enqueue",
        "dl.pause",
        "dl.resume",
        "dl.cancel",
        "dl.status",
        "dl.list",
        "dl.events",
        "dl.prune",
        "crawl.run"
      ]
    },
    "request": {
      "title": "一次调用（sidecar 的请求体 / stdio 的一行）",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "id": {
          "description": "传输层流水号，原样回带；不属于契约载荷。"
        },
        "method": {
          "$ref": "#/$defs/method"
        },
        "params": {
          "type": "object",
          "description": "各 method 自己的参数；缺省等价于 {}。"
        },
        "token": {
          "type": "string",
          "description": "sidecar 鉴权 token 的便利字段（也可放 X-XSpider-Token / Authorization 头）。"
        }
      }
    },
    "user": {
      "title": "用户",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "screen_name",
        "name",
        "avatar"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "数字 id 的字符串形式（超出 f64 精度，不许当数字传）。"
        },
        "screen_name": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "avatar": {
          "type": "string"
        },
        "media_count": {
          "type": [
            "integer",
            "null"
          ],
          "description": "缺失时为 null——null 是“没给这个字段”，0 是“确实没有媒体”，两者语义不同。"
        },
        "register_time": {
          "type": [
            "string",
            "null"
          ],
          "description": "RFC3339 UTC；缺失时为 null。"
        }
      }
    },
    "netStatus": {
      "title": "限流状态",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "ok",
            "rate_limited"
          ]
        },
        "rate_limited_until": {
          "type": "integer",
          "description": "Unix 秒（UTC）。仅 rate_limited 时出现。"
        },
        "retry_after_s": {
          "type": "integer",
          "minimum": 0,
          "description": "仅 rate_limited 时出现。"
        }
      }
    },
    "mediaVariant": {
      "title": "媒体码率变体",
      "description": "已过滤掉 HLS（application/x-mpegURL）——播放列表不是可下载文件。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "content_type"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "content_type": {
          "type": "string"
        },
        "bitrate": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "media": {
      "title": "媒体",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "url",
        "ext"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "photo",
            "video",
            "animated_gif"
          ],
          "description": "沿用 X 自己的命名，避免再造一套词汇。"
        },
        "id": {
          "type": "string",
          "description": "X 的 media id（字符串）。比 URL 稳定，适合做去重与文件名。"
        },
        "url": {
          "type": "string",
          "description": "可直接下载的 URL。图片是不含查询串的 media_url_https（需要缩略图时由外壳自行追加尺寸参数）；视频/动图已选好最高码率变体。"
        },
        "ext": {
          "type": "string",
          "description": "扩展名（不含点），由 URL 推断。"
        },
        "poster_url": {
          "type": [
            "string",
            "null"
          ],
          "description": "封面图（X 的 media_url_https）：视频/动图播放前的静帧，图片则是它本身（不带 ?name=）。**不是可下载的媒体文件**——视频的播放地址在 url/variants。界面把它当图片解码；给了 mp4 链接会导致视频格子空白。"
        },
        "width": {
          "type": [
            "integer",
            "null"
          ]
        },
        "height": {
          "type": [
            "integer",
            "null"
          ]
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "aspect_ratio": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mediaVariant"
          },
          "description": "全部码率变体（已过滤 HLS）。图片为空数组（该键此时不出现）。"
        }
      }
    },
    "postAuthor": {
      "title": "推文作者",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "screen_name",
        "name",
        "avatar"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "screen_name": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "avatar": {
          "type": "string"
        }
      }
    },
    "post": {
      "title": "推文",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "full_text",
        "favorite_count",
        "retweet_count",
        "reply_count",
        "possibly_sensitive",
        "author",
        "favorited",
        "retweeted",
        "bookmarked"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "数字 id 的字符串形式（超出 f64 精度，不许当数字传）。"
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "RFC3339 UTC；X 没给时间时为 null（该条目仍会被保留，见 docs/02 §D4）。"
        },
        "full_text": {
          "type": "string"
        },
        "lang": {
          "type": [
            "string",
            "null"
          ]
        },
        "views": {
          "type": [
            "integer",
            "null"
          ]
        },
        "favorite_count": {
          "type": "integer",
          "minimum": 0
        },
        "retweet_count": {
          "type": "integer",
          "minimum": 0
        },
        "reply_count": {
          "type": "integer",
          "minimum": 0
        },
        "bookmark_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "quote_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "possibly_sensitive": {
          "type": "boolean"
        },
        "bookmarked": {
          "type": "boolean",
          "description": "我有没有收藏这条。"
        },
        "retweeted": {
          "type": "boolean",
          "description": "我有没有转推这条。"
        },
        "favorited": {
          "type": "boolean",
          "description": "我有没有点赞这条（**状态**，不是计数）。外壳据此决定按钮实心/空心。"
        },
        "medias": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/media"
          },
          "description": "无媒体时该键不出现（不是空数组）。"
        },
        "author": {
          "$ref": "#/$defs/postAuthor"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "话题标签文本（不含 #）。"
        },
        "quoted_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "被引用推文的 id。"
        },
        "quoted": {
          "anyOf": [
            {
              "$ref": "#/$defs/post"
            },
            {
              "type": "null"
            }
          ],
          "description": "**被引用的那条推文**（引用卡片要显示正文/作者/媒体）。**只嵌一层**：引用里的引用不再展开（防递归）。取不到（被删/不可见）时该键不出现，此时仍有 `quoted_id` 可让外壳单独去取。"
        },
        "in_reply_to_screen_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "本条回复的是谁——是**被回复者**，不是本条作者（docs/02 §C2）。"
        },
        "in_reply_to_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "retweeted_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/postAuthor"
            },
            {
              "type": "null"
            }
          ],
          "description": "转推时是谁转的；仅当 include_retweets 打开时出现。"
        }
      }
    },
    "reply": {
      "title": "回复",
      "description": "推文字段**摊平**在顶层（外壳处理回复与处理推文是同一套代码），外加回复特有的两个字段。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "full_text",
        "author",
        "is_partial_parent",
        "favorited",
        "retweeted",
        "bookmarked"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "数字 id 的字符串形式（超出 f64 精度，不许当数字传）。"
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "RFC3339 UTC；X 没给时间时为 null（该条目仍会被保留，见 docs/02 §D4）。"
        },
        "full_text": {
          "type": "string"
        },
        "lang": {
          "type": [
            "string",
            "null"
          ]
        },
        "views": {
          "type": [
            "integer",
            "null"
          ]
        },
        "favorite_count": {
          "type": "integer",
          "minimum": 0
        },
        "retweet_count": {
          "type": "integer",
          "minimum": 0
        },
        "reply_count": {
          "type": "integer",
          "minimum": 0
        },
        "bookmark_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "quote_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "possibly_sensitive": {
          "type": "boolean"
        },
        "favorited": {
          "type": "boolean",
          "description": "我有没有点赞这条（**状态**，不是计数）。外壳据此决定按钮实心/空心。"
        },
        "retweeted": {
          "type": "boolean",
          "description": "我有没有转推这条。"
        },
        "bookmarked": {
          "type": "boolean",
          "description": "我有没有收藏这条。"
        },
        "medias": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/media"
          },
          "description": "无媒体时该键不出现（不是空数组）。"
        },
        "author": {
          "$ref": "#/$defs/postAuthor"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "话题标签文本（不含 #）。"
        },
        "quoted_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "被引用推文的 id。"
        },
        "quoted": {
          "anyOf": [
            {
              "$ref": "#/$defs/post"
            },
            {
              "type": "null"
            }
          ],
          "description": "**被引用的那条推文**（引用卡片要显示正文/作者/媒体）。**只嵌一层**：引用里的引用不再展开（防递归）。取不到（被删/不可见）时该键不出现，此时仍有 `quoted_id` 可让外壳单独去取。"
        },
        "in_reply_to_screen_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "本条回复的是谁——是**被回复者**，不是本条作者（docs/02 §C2）。"
        },
        "in_reply_to_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "retweeted_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/postAuthor"
            },
            {
              "type": "null"
            }
          ],
          "description": "转推时是谁转的；仅当 include_retweets 打开时出现。"
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "本回复在回复谁（父推文 id）。"
        },
        "is_partial_parent": {
          "type": "boolean",
          "description": "父推文不在本页（孤儿）。这类条目**不会被丢弃**，外壳据此决定是否拉取上下文（docs/02 §C2）。"
        }
      }
    },
    "postPage": {
      "title": "推文分页结果",
      "description": "**单页 + 游标，不自动翻页**（docs/01 §3 硬性设计 1）：翻页时机、过滤、去重是业务语义，必须让调用方看得见游标。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "end"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/post"
          }
        },
        "cursor": {
          "type": "string",
          "description": "下一页要传的游标。**该键不出现即表示服务端没有更多了**（end=true）。"
        },
        "end": {
          "type": "boolean",
          "description": "cursor 不出现时为 true。"
        }
      }
    },
    "userPage": {
      "title": "用户分页结果",
      "description": "与 postPage 同形（所有分页端点统一用 items，外壳只需写一个翻页循环）。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "end"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/user"
          }
        },
        "cursor": {
          "type": "string"
        },
        "end": {
          "type": "boolean"
        }
      }
    },
    "tweetDetail": {
      "title": "推文详情",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focal",
        "replies"
      ],
      "properties": {
        "focal": {
          "$ref": "#/$defs/post",
