    "doneReason": {
      "title": "爬取终止原因",
      "description": "**必须显式**：「翻到服务端尽头」与「被策略提前终止」是两种语义，外壳靠它决定文案与下次是否续爬（docs/01 §4）。",
      "type": "string",
      "enum": [
        "exhausted",
        "time_progressed",
        "empty_pages",
        "cursor_stuck",
        "wanted_collected",
        "cancelled",
        "error",
        "page_limit_reached"
      ]
    }
