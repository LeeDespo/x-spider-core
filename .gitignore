# --- 生成物（不提交）---
/target/
/dist/
# CLI 的默认落盘目录：bins/xspider-cli 默认写这里，README 与接入手册的 live 示例
# 就是在仓库根目录跑它，跑完会留下一堆媒体文件
/downloads/
**/*.rs.bk
*.pdb

# --- 测试/录制产物 ---
# 录制模式的原始响应：脱敏之后才允许入库（见 docs/04-TESTING-AND-FIXTURES.md §2.1）
/fixtures/**/raw/
*.record.json

# --- 凭据（绝不入库，也绝不落盘；这里只是双保险）---
.env
.env.*
# 但环境变量模板（占位符，非真实凭据）应当能入库
!.env.example
*.cookie
cookie.txt

# --- 本地状态（sidecar 的 state-dir / 任务状态）---
/.xspider-state/
/state/

# --- 本地工作文件（一次性启动简报/验收工作单）：不上传 ---
/docs/00-KICKOFF.md
/ACCEPTANCE.md

# 其他 agent 工具的本地配置（不进仓库）
/CLAUDE.md
/GEMINI.md
/.cursorrules
/.cursor/
/.codex/
/.aider*
/.zcode/

# --- OS / 编辑器噪音 ---
.DS_Store
.idea/
.vscode/
# 补丁 / 合并残留与编辑器备份
*.orig
*.rej
*.tmp
*.bak

# Python 字节码缓存（脱敏脚本跑过就会生成）
__pycache__/
*.pyc
